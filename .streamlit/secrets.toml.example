# EdgeReader secrets, example.
#
# Copy this file to  .streamlit/secrets.toml  and paste your real keys.
# On Streamlit Community Cloud do NOT commit secrets.toml; instead open your app,
# then Settings, then Secrets, and paste the same content there.
#
# Every provider takes as many keys as you want, one per line in a TOML array,
# each in double quotes with a comma after it. They are tried in order, so if a
# key is rate limited or rejected the next one is used automatically.

# Groq is free. It powers AI titles, translation, and Whisper transcription.
groq_keys = [
  "gsk_replace_with_key_1",
  "gsk_replace_with_key_2",
  "gsk_replace_with_key_3",
  "gsk_replace_with_key_4",
  "gsk_replace_with_key_5",
]

# AssemblyAI (paid), an alternative transcription engine. Paste 5 or more.
assemblyai_keys = [
  "assemblyai_replace_with_key_1",
  "assemblyai_replace_with_key_2",
  "assemblyai_replace_with_key_3",
  "assemblyai_replace_with_key_4",
  "assemblyai_replace_with_key_5",
]

# Google (paid), an alternative translation engine. gemini_keys also works.
google_keys = [
  "AIza_replace_with_key_1",
  "AIza_replace_with_key_2",
]

# Numbered singles are also accepted if you prefer, for any provider:
# assemblyai_key_1 = "assemblyai_replace_with_key_1"
# assemblyai_key_2 = "assemblyai_replace_with_key_2"
